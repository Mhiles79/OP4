<?xml version="1.0" encoding="UTF-8"?>
<!--
    Für das SAX-Beispiel: eine einfache Liste von Studenten.
    SAX liest diese Datei von oben nach unten, Zeile für Zeile,
    und feuert bei jedem Tag ein "Ereignis" (Event).
-->
<students>
    <student id="s1">
        <name>Anna Müller</name>
        <grade>1.3</grade>
    </student>
    <student id="s2">
        <name>Ben Schmidt</name>
        <grade>2.7</grade>
    </student>
    <student id="s3">
        <name>Clara Weber</name>
        <grade>1.0</grade>
    </student>
</students>
