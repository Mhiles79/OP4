<!ELEMENT warenliste (ware+)>
<!ELEMENT ware (bezeichnung, preis, bestand, beschreibung)>
<!ELEMENT bezeichnung  (#PCDATA)>
<!ELEMENT preis        (#PCDATA)>
<!ELEMENT bestand      (#PCDATA)>
<!ELEMENT beschreibung (#PCDATA)>

<!ATTLIST ware
